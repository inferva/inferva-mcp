{
  "name": "@inferva/mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol server for INFERVA: one inference endpoint AI agents pay through, plus read tools for stats, providers, governance and the verifiable settlement log.",
  "license": "MIT",
  "author": "INFERVA",
  "type": "module",
  "homepage": "https://inferva.xyz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inferva/inferva-mcp.git"
  },
  "bugs": "https://github.com/inferva/inferva-mcp/issues",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "inferva",
    "inference",
    "ai-agents",
    "settlement"
  ],
  "bin": {
    "inferva-mcp": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
